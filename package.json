{
  "name": "fe-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "prebuild": "pnpm questions:check && pnpm questions:index:check && pnpm questions:bundle:check && pnpm round:check",
    "build": "react-router build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview pnpm run build && wrangler deploy",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && pnpm typecheck && pnpm questions:check && pnpm questions:index:check && pnpm questions:bundle:check && pnpm round:check && pnpm test",
    "questions:check": "tsx scripts/check-questions.ts",
    "questions:index": "tsx scripts/build-questions-index.ts",
    "questions:index:check": "tsx scripts/build-questions-index.ts --check",
    "questions:bundle": "tsx scripts/build-questions-json.ts",
    "questions:bundle:check": "tsx scripts/build-questions-json.ts --check",
    "questions:prepare-batch": "tsx scripts/prepare-batch.ts",
    "questions:write-generated": "tsx scripts/write-generated.ts",
    "round:check": "tsx scripts/check-round.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "isbot": "^5.1.36",
    "nanoid": "^5.1.11",
    "posthog-js": "^1.425.1",
    "posthog-node": "^5.33.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "workers-og": "^0.0.27",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@cloudflare/vite-plugin": "^1.52.1",
    "@playwright/test": "^1.50.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.123.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
