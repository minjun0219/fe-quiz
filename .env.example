# Copy to `.env` and fill in real values. (`.env`는 gitignored — 로컬 dev용)
#
# VITE_* 는 빌드 타임에 클라이언트 번들로 인라인된다 — 클라이언트 노출 OK인
# 값만 여기에. **production 값은 커밋된 `.env.production`이 단일 출처**
# (vite가 production 빌드에서 자동 로드 — write-only 키라 커밋 안전).

# PostHog Project API key (phc_...) — write-only(이벤트 ingest)라 노출돼도
# read 권한 없음. 미설정이면 클라이언트 PostHog는 no-op.
VITE_POSTHOG_KEY=
# us 리전이면 그대로. eu는 https://eu.i.posthog.com. 자체 호스팅이면 그 origin.
VITE_POSTHOG_HOST=https://us.i.posthog.com
