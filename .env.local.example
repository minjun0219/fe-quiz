# Copy to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit secrets.

# --- Site ---
# Used for canonical URLs, OG image base, share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# 서버 전용 service_role 키. RLS를 우회하므로 우리 route handler가 유일한
# 합법 진입점이 된다. anon RLS 정책은 0개로 잠가둠 (`...lock_down_shares_rls.sql`).
#
# ⚠️ 절대 클라이언트로 노출 X. NEXT_PUBLIC_ 접두사 붙이지 말 것. 깃에 커밋 X.
# ⚠️ Vercel에서도 Production/Preview 환경 모두 server-only로만 설정.
# ⚠️ 유출되면 즉시 Supabase 대시보드에서 키 회전 (Settings → API → Roll service_role).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (PR #6 onwards, Claude Haiku 4.5 feedback) ---
ANTHROPIC_API_KEY=
