# Copy to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit secrets.

# --- Site ---
# Used for canonical URLs, OG image base, share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# `publishable` key (sb_publishable_...) — Supabase의 새 API key 체계.
# 레거시 `anon` JWT도 호환되지만 신규 프로젝트는 publishable 권장.
# NEXT_PUBLIC_ 접두사 없음: lib/supabase.ts는 서버 전용이라 브라우저
# 번들에 노출시킬 이유 없음. 클라에서 Supabase JS를 직접 쓸 일이
# 생기면 그때 NEXT_PUBLIC_ 버전을 추가.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Anthropic (PR #6 onwards, Claude Haiku 4.5 feedback) ---
ANTHROPIC_API_KEY=
