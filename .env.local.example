# Copy to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit secrets.

# --- Site ---
# Used for canonical URLs, OG image base, share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (PR #2 onwards) ---
# `publishable` key (sb_publishable_...) — Supabase의 새 API key 체계.
# 레거시 `anon` JWT도 호환되지만 신규 프로젝트는 publishable 권장.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Anthropic (PR #6 onwards, Claude Haiku 4.5 feedback) ---
ANTHROPIC_API_KEY=
