# Copy to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit secrets.

# --- Site ---
# Used for canonical URLs, OG image base, share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# 서버 전용 secret 키 (새 `sb_secret_...` 또는 legacy service_role JWT — 둘
# 다 RLS 우회). 우리 route handler가 유일한 합법 진입점이 된다. anon RLS
# 정책은 0개로 잠가둠 (`...lock_down_shares_rls.sql`).
#
# ⚠️ 절대 클라이언트로 노출 X. NEXT_PUBLIC_ 접두사 붙이지 말 것. 깃에 커밋 X.
# ⚠️ Vercel에서도 Production/Preview 환경 모두 server-only로만 설정.
# ⚠️ 유출되면 즉시 Supabase 대시보드에서 키 회전·삭제 (Settings → API Keys).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Anthropic (PR #6 onwards, Claude Haiku 4.5 feedback) ---
ANTHROPIC_API_KEY=

# --- Rate limiting (Upstash Redis) ---
# 미설정 시 fail-open(rate limit 비활성). 로컬 dev엔 선택, production 권장.
# Upstash 대시보드(https://console.upstash.com)에서 Redis DB 만들고
# REST API URL + token 발급. Vercel은 서버 전용으로 박을 것 (NEXT_PUBLIC_ X).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Logging ---
# pino 로그 레벨. 미설정 시 dev=debug / prod=info / test=silent.
# 값: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=
