# Copy to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit secrets.

# --- Site ---
# Used for canonical URLs, OG image base, share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# 환경별로 두 개의 Supabase 프로젝트를 사용한다 (`lib/supabase.ts`):
#   - production (VERCEL_ENV=production)
#       → SUPABASE_URL / SUPABASE_SECRET_KEY  (운영 전용 프로젝트)
#   - 그 외 (Vercel preview, 로컬 dev, CI)
#       → SUPABASE_DEV_URL / SUPABASE_DEV_SECRET_KEY  (공유 개발 프로젝트)
#
# 분기 기준은 NODE_ENV가 아니라 VERCEL_ENV. `next start`로 로컬에서 prod
# 빌드를 돌려도 절대 운영 DB를 안 건드리도록.
#
# 로컬 개발은 보통 SUPABASE_DEV_* 만 채우면 된다. Vercel에는:
#   - Production 스코프: SUPABASE_URL / SUPABASE_SECRET_KEY 만
#   - Preview + Development 스코프: SUPABASE_DEV_URL / SUPABASE_DEV_SECRET_KEY 만
# "All Environments" 스코프에 운영 키를 박는 건 금지 (preview 빌드로 prod
# 데이터를 건드릴 수 있음).
#
# 키 자체는 새 `sb_secret_...` 또는 legacy service_role JWT (둘 다 RLS 우회).
# 우리 route handler가 유일한 합법 진입점이 된다. anon RLS 정책은 0개로
# 잠가둠 (`...lock_down_shares_rls.sql`).
#
# ⚠️ 절대 클라이언트로 노출 X. NEXT_PUBLIC_ 접두사 붙이지 말 것. 깃에 커밋 X.
# ⚠️ 유출되면 즉시 Supabase 대시보드에서 키 회전·삭제 (Settings → API Keys).

# Production-only (Vercel Production 스코프 전용)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Non-prod: Vercel Preview/Development 스코프 + 로컬 .env.local
SUPABASE_DEV_URL=
SUPABASE_DEV_SECRET_KEY=

# --- Anthropic (PR #6 onwards, Claude Haiku 4.5 feedback) ---
ANTHROPIC_API_KEY=

# --- Rate limiting (Upstash Redis) ---
# 미설정 시 fail-open(rate limit 비활성). 로컬 dev엔 선택, production 권장.
# Upstash 대시보드(https://console.upstash.com)에서 Redis DB 만들고
# REST API URL + token 발급. Vercel은 서버 전용으로 박을 것 (NEXT_PUBLIC_ X).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Logging ---
# pino 로그 레벨. 미설정/허용 외 값은 dev=debug / prod=info / test=silent.
# 허용: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=

# --- PostHog (error monitoring + product analytics + session replay) ---
# 미설정이면 PostHog 호출은 모두 no-op (lib/posthog-server.ts, PostHogProvider).
# Project API key (phc_...) — 클라이언트 노출 OK. write-only(이벤트 ingest)라
# 노출돼도 read 권한 없음. PROJECT 단위로 발급 (Settings → Project).
NEXT_PUBLIC_POSTHOG_KEY=
# us 리전이면 그대로. eu는 https://eu.i.posthog.com. 자체 호스팅이면 그 origin.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
